# PostgreSQL
DB_USERNAME=music_user
DB_PASSWORD=change_me
DB_DATABASE=music_platform
# Порт Postgres на хосте (127.0.0.1). Внутри docker backend всегда ходит на postgres:5432
DB_PORT=5432

# Порт backend на хосте
APP_PORT=4000
NODE_ENV=production

# Только для разового переноса данных: node dist/database/migrate-from-mongo.js
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/music-platform
CLEAR_EXISTING_DATA=false

# Адрес фронтенда: ссылки в письмах и CORS
APP_URL=https://wave-music.pro
CORS_ORIGIN=https://wave-music.pro
# true на сервере с HTTPS — cookie сессии только по защищённому соединению
COOKIE_SECURE=true

# Почта для подтверждения регистрации и сброса пароля (без SMTP_HOST письма пишутся в лог)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@wave-music.pro
SMTP_PASSWORD=change_me
MAIL_FROM="Wave music <noreply@wave-music.pro>"

# Первый администратор создаётся при запуске, если такого пользователя ещё нет
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
