# PostgreSQL
DB_USERNAME=music_user
DB_PASSWORD=change_me
DB_DATABASE=music_platform
# Порт Postgres на хосте (127.0.0.1). Внутри docker backend всегда ходит на postgres:5432
DB_PORT=5432

# Порт backend на хосте
APP_PORT=4000
NODE_ENV=production

# Только для разового переноса данных: node dist/database/migrate-from-mongo.js
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/music-platform
CLEAR_EXISTING_DATA=false
